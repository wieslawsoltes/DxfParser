{
  "name": "@wieslawsoltes/dxf-analysis",
  "version": "0.3.0",
  "description": "Interactive record tables, linked analytical visualizations and bounded aggregation models",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.mts",
  "exports": {
    ".": {
      "types": "./index.d.mts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    },
    "./package.json": "./package.json",
    "./models": {
      "types": "./models.d.mts",
      "import": "./src/models.mjs",
      "require": "./models.cjs"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "src/",
    "index.mjs",
    "index.cjs",
    "index.d.mts",
    "README.md",
    "LICENSE",
    "styles.css",
    "models.cjs",
    "models.d.mts",
    "styles/"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wieslawsoltes/DxfParser.git",
    "directory": "packages/dxf-analysis"
  }
}
