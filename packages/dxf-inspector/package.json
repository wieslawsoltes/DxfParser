{
  "name": "@wieslawsoltes/dxf-inspector",
  "version": "0.2.0",
  "description": "DXF source-tree parsing, structural comparison, diagnostics and binary inspection utilities",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.mts",
  "exports": {
    ".": {
      "types": "./index.d.mts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "index.mjs",
    "index.cjs",
    "index.d.mts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wieslawsoltes/DxfParser.git",
    "directory": "packages/dxf-inspector"
  }
}
