{
  "name": "@wieslawsoltes/dxf-tree-view",
  "version": "0.1.0",
  "description": "Virtualized DXF source-tree viewport with editing, alignment and diff overview",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.mts",
  "exports": {
    ".": {
      "types": "./index.d.mts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    },
    "./package.json": "./package.json",
    "./styles.css": "./styles.css"
  },
  "files": [
    "src/",
    "index.mjs",
    "index.cjs",
    "index.d.mts",
    "README.md",
    "LICENSE",
    "styles.css"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wieslawsoltes/DxfParser.git",
    "directory": "packages/dxf-tree-view"
  }
}
